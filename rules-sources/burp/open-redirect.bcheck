metadata:
    language: v2-beta
    name: "Open Redirect via redirect parameter"
    description: "Detects an open redirect issue where the application accepts a user-controlled URL in the 'redirect' query parameter and issues a redirect to it."
    author: "corvex fixtures"
    tags: "redirect", "active"

given query then
    if {base.query} matches "(?i)^(redirect|url|next|return)=" then
        send request called check:
            replacing query: "{base.query.name}=https://evil.example.com/"

        if {check.response.status_code} is "302" and
           {check.response.headers/Location} matches "^https?://evil\\.example\\.com" then
            report issue:
                severity: high
                confidence: firm
                detail: "An open redirect was found. The application redirects to a user-controlled URL."
                remediation: "Validate the redirect target against an allowlist of permitted domains."
        end if
    end if
