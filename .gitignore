# --- Rust / Cargo -----------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb

# Coverage / profiling artifacts
*.profraw
*.profdata
lcov.info
tarpaulin-report.*
flamegraph.svg
perf.data*

# OpenSSL vendored source build scratch (from openssl-src)
**/openssl-build/

# --- Environment ------------------------------------------------------------
.env
.env.*
.envrc

# --- Node / npm -------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*

# --- IDE / editor -----------------------------------------------------------
.vscode/
.idea/
*.iml
.cursor/
.claude/
*.swp
*.swo
*~

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Corvex local overrides --------------------------------------------------
# Upstream convention: the copied-from-default local config is never tracked.
corvex.conf
tests/udb_*

# Local-only research clones (e.g. librenms checkout for upstream reference)
/upstream-fetch/

# --- corvex-feed-harvest: dev-only cache of the OpenVAS Community Feed -------
# The harvester rsync's the feed under program/feed-cache/openvas/ to extract
# metadata facts for rule scaffolds. NASL files MUST NOT enter the repo —
# rules are re-authored against vendor advisories under
# rules-sources/openvas-port/. See crates/corvex-feed-harvest/LICENSE_NOTES.md.
/program/feed-cache/
**/program/feed-cache/
*.nasl

# --- Scan output written to the repo root -----------------------------------
/*.json
/*.xml
/*.html
/*.htm
/*.csv
/*.sql
/*.log
/scan-*.txt

# --- committed catalog artifacts ---------------------------------------------
# `program/rules/rules.sqlite` and `program/devicedb/devices.sqlite` ARE
# tracked: committing them lets fresh clones build + run the desktop binary
# without first having to run the relevant builder. The canonical workflow
# is "rebuild + re-commit" whenever the upstream sources change.
# Side-files SQLite produces during in-flight writes are still ignored —
# only the finished catalog should land in git.
/program/rules/rules.sqlite-journal
/program/rules/rules.sqlite-wal
/program/rules/rules.sqlite-shm
/program/devicedb/devices.sqlite-journal
/program/devicedb/devices.sqlite-wal
/program/devicedb/devices.sqlite-shm
