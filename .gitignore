# --- Rust / Cargo -----------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb

# Coverage / profiling artifacts
*.profraw
*.profdata
lcov.info
tarpaulin-report.*
flamegraph.svg
perf.data*

# OpenSSL vendored source build scratch (from openssl-src)
**/openssl-build/

# --- Environment ------------------------------------------------------------
.env
.env.*
.envrc

# --- Node / npm -------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*

# --- IDE / editor -----------------------------------------------------------
.vscode/
.idea/
*.iml
.cursor/
.claude/
*.swp
*.swo
*~

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Corvex local overrides --------------------------------------------------
# Upstream convention: the copied-from-default local config is never tracked.
corvex.conf
tests/udb_*

# --- Scan output written to the repo root -----------------------------------
/*.json
/*.xml
/*.html
/*.htm
/*.csv
/*.sql
/*.log
/scan-*.txt

# --- corvex-rules-builder output ---------------------------------------------
# `/rules.sqlite` IS tracked: committing it lets fresh clones run the unified
# scanner path without first running `cargo run -p corvex-rules-builder`. The
# canonical workflow is "rebuild + re-commit" whenever rules-sources/ changes.
# Side-files SQLite produces during in-flight writes are still ignored — only
# the finished catalog should land in git.
/rules.sqlite-journal
/rules.sqlite-wal
/rules.sqlite-shm
