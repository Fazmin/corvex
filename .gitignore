corvex.conf
tests/udb_*

# --- Scan output written to the repo root -----------------------------------
/*.json
/*.xml
/*.html
/*.htm
/*.csv
/*.sql
/*.log
/scan-*.txt
snapshot.db.gz
*/vulndb/snapshot.db.gz
snapshot.db.gz

# --- corvex-rules-builder output ---------------------------------------------
# The unified rules SQLite catalog is a build artifact; it's regenerated by
# running `cargo run -p corvex-rules-builder`. Don't commit it.
/rules.sqlite
/rules.sqlite-journal
/rules.sqlite-wal
/rules.sqlite-shm
