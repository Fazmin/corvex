<?xml version="1.0" encoding="UTF-8"?>
<fingerprints matches="dns.version">

  <fingerprint pattern="BIND ([0-9][0-9a-zA-Z._-]+)">
    <description>BIND version.bind response</description>
    <param pos="0" name="service.product" value="BIND"/>
    <param pos="1" name="service.version"/>
    <param pos="0" name="service.cpe23" value="cpe:2.3:a:isc:bind:{service.version}:*:*:*:*:*:*:*"/>
  </fingerprint>

  <fingerprint pattern="^dnsmasq-(\d+\.\d+)">
    <description>dnsmasq version</description>
    <param pos="0" name="service.product" value="dnsmasq"/>
    <param pos="1" name="service.version"/>
  </fingerprint>

  <fingerprint pattern="PowerDNS\s+Recursor\s+([0-9.]+)">
    <description>PowerDNS Recursor</description>
    <param pos="0" name="service.product" value="PowerDNS Recursor"/>
    <param pos="1" name="service.version"/>
  </fingerprint>

</fingerprints>
