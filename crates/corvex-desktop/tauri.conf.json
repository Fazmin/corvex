{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "corvex-rust",
  "version": "0.1.0",
  "identifier": "dev.fazminnizam.corvex-rust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "corvex-rust",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../program/databases/nuclei": "program/databases/nuclei",
      "../../program/databases/exploitdb": "program/databases/exploitdb",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../program/corvex.conf.default": "corvex.conf.default"
    }
  }
}
